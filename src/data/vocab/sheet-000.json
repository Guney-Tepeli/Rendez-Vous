[
  {"id":"à côté","level":"A1","pos":"expression","ipa":"a ko.te","tr":"yanında, bitişikte","en":"next door, beside","chunks":[["à côté de","-in yanında","next to"],["juste à côté","hemen yanında","right next door"]],"examples":[["La boulangerie est à côté de la banque.","Fırın bankanın yanında.","The bakery is next to the bank."],["J'habite à côté.","Hemen bitişikte oturuyorum.","I live next door."]]},
  {"id":"bagage","level":"A1","pos":"noun","gender":"m","plural":"bagages","ipa":"ba.ɡaʒ","tr":"bagaj, valiz","en":"luggage, bag","chunks":[["faire ses bagages","bavulunu hazırlamak","to pack one's bags"],["un bagage à main","el bagajı","a carry-on bag"]],"examples":[["Où sont mes bagages ?","Bagajlarım nerede?","Where is my luggage?"],["J'ai un seul bagage.","Tek bir bagajım var.","I have only one bag."]]},
  {"id":"c'est","level":"A1","pos":"expression","ipa":"sɛ","tr":"bu ...-dır, bu","en":"it is, this is","chunks":[["c'est bon","güzel / tamam","it's good / that's fine"],["c'est à moi","bu benim","it's mine"],["qu'est-ce que c'est ?","bu nedir?","what is it?"]],"examples":[["C'est mon frère.","Bu benim erkek kardeşim.","This is my brother."],["C'est très facile.","Bu çok kolay.","It's very easy."]]},
  {"id":"d'abord","level":"A1","pos":"expression","ipa":"da.bɔʁ","tr":"önce, ilk olarak","en":"first, first of all","chunks":[["tout d'abord","her şeyden önce","first of all"],["d'abord..., ensuite...","önce..., sonra...","first..., then..."]],"examples":[["D'abord, je prends un café.","Önce bir kahve içiyorum.","First, I have a coffee."],["Lave-toi les mains d'abord.","Önce ellerini yıka.","Wash your hands first."]]},
  {"id":"e-mail","level":"A1","pos":"noun","gender":"m","plural":"e-mails","ipa":"i.mɛl","tr":"e-posta","en":"email","chunks":[["envoyer un e-mail","e-posta göndermek","to send an email"],["une adresse e-mail","e-posta adresi","an email address"]],"examples":[["Je t'envoie un e-mail ce soir.","Bu akşam sana bir e-posta gönderiyorum.","I'll send you an email tonight."],["Tu as reçu mon e-mail ?","E-postamı aldın mı?","Did you get my email?"]]},
  {"id":"facile","level":"A1","pos":"adjective","feminine":"facile","ipa":"fa.sil","tr":"kolay","en":"easy","chunks":[["c'est facile","bu kolay","it's easy"],["facile à faire","yapması kolay","easy to do"]],"examples":[["Cet exercice est facile.","Bu alıştırma kolay.","This exercise is easy."],["Le français n'est pas toujours facile.","Fransızca her zaman kolay değildir.","French is not always easy."]]},
  {"id":"gagner","level":"A1","pos":"verb","group":1,"present":["gagne","gagnes","gagne","gagnons","gagnez","gagnent"],"ipa":"ɡa.ɲe","tr":"kazanmak","en":"to win, to earn","chunks":[["gagner de l'argent","para kazanmak","to earn money"],["gagner du temps","zaman kazanmak","to save time"],["gagner un match","maç kazanmak","to win a match"]],"examples":[["Notre équipe gagne toujours.","Takımımız her zaman kazanır.","Our team always wins."],["Elle gagne bien sa vie.","Hayatını iyi kazanıyor.","She earns a good living."]]},
  {"id":"habiter","level":"A1","pos":"verb","group":1,"present":["habite","habites","habite","habitons","habitez","habitent"],"ipa":"a.bi.te","tr":"oturmak, (bir yerde) yaşamak","en":"to live (somewhere)","chunks":[["habiter à Paris","Paris'te oturmak","to live in Paris"],["habiter en France","Fransa'da yaşamak","to live in France"],["habiter seul","yalnız yaşamak","to live alone"]],"examples":[["J'habite à Istanbul.","İstanbul'da oturuyorum.","I live in Istanbul."],["Où habitez-vous ?","Nerede oturuyorsunuz?","Where do you live?"]]},
  {"id":"ici","level":"A1","pos":"other","ipa":"i.si","tr":"burada, buraya","en":"here","chunks":[["par ici","bu taraftan","this way"],["près d'ici","buraya yakın","near here"],["d'ici","buradan, buralı","from here"]],"examples":[["Viens ici !","Buraya gel!","Come here!"],["Il fait froid ici.","Burası soğuk.","It's cold here."]]},
  {"id":"j'achète","level":"A1","pos":"expression","ipa":"ʒa.ʃɛt","tr":"satın alıyorum","en":"I buy, I'm buying","chunks":[["j'achète du pain","ekmek alıyorum","I'm buying bread"],["je n'achète pas","almıyorum","I don't buy"]],"examples":[["J'achète des fruits au marché.","Pazardan meyve alıyorum.","I buy fruit at the market."],["J'achète un cadeau pour ma mère.","Annem için bir hediye alıyorum.","I'm buying a present for my mother."]]},
  {"id":"kilo","level":"A1","pos":"noun","gender":"m","plural":"kilos","ipa":"ki.lo","tr":"kilo","en":"kilo, kilogram","chunks":[["un kilo de tomates","bir kilo domates","a kilo of tomatoes"],["un demi-kilo","yarım kilo","half a kilo"]],"examples":[["Je voudrais un kilo de pommes, s'il vous plaît.","Bir kilo elma istiyorum, lütfen.","I'd like a kilo of apples, please."],["Ce sac pèse dix kilos.","Bu çanta on kilo geliyor.","This bag weighs ten kilos."]]},
  {"id":"l'ai","lemma":"je l'ai","level":"A2","pos":"expression","ipa":"ʒə le","tr":"bende, ona sahibim","en":"I have it","chunks":[["je ne l'ai pas","bende yok","I don't have it"],["je l'ai vu","onu gördüm","I saw it / him"]],"examples":[["Ton livre ? Je l'ai.","Kitabın mı? Bende.","Your book? I have it."],["Je l'ai acheté hier.","Onu dün satın aldım.","I bought it yesterday."]]},
  {"id":"m'appelle","lemma":"je m'appelle","level":"A1","pos":"expression","ipa":"ʒə ma.pɛl","tr":"adım ...","en":"my name is","chunks":[["comment tu t'appelles ?","adın ne?","what's your name?"],["il s'appelle","onun adı ...","his name is"]],"examples":[["Bonjour, je m'appelle Marie.","Merhaba, adım Marie.","Hello, my name is Marie."],["Je m'appelle Paul, et toi ?","Adım Paul, ya senin?","My name is Paul, and you?"]]},
  {"id":"n'ai pas","lemma":"je n'ai pas","level":"A1","pos":"expression","ipa":"ʒə ne pa","tr":"bende yok, ...-m yok","en":"I don't have","chunks":[["je n'ai pas le temps","vaktim yok","I don't have time"],["je n'ai pas faim","aç değilim","I'm not hungry"]],"examples":[["Je n'ai pas de voiture.","Arabam yok.","I don't have a car."],["Je n'ai pas compris.","Anlamadım.","I didn't understand."]]},
  {"id":"occupé","level":"A1","pos":"adjective","feminine":"occupée","ipa":"ɔ.ky.pe","tr":"meşgul, dolu","en":"busy, occupied","chunks":[["être occupé","meşgul olmak","to be busy"],["la ligne est occupée","hat meşgul","the line is busy"]],"examples":[["Je suis très occupé aujourd'hui.","Bugün çok meşgulüm.","I am very busy today."],["Les toilettes sont occupées.","Tuvalet dolu.","The toilet is occupied."]]},
  {"id":"page","level":"A1","pos":"noun","gender":"f","plural":"pages","ipa":"paʒ","tr":"sayfa","en":"page","chunks":[["tourner la page","sayfayı çevirmek","to turn the page"],["à la page dix","onuncu sayfada","on page ten"]],"examples":[["Ouvrez le livre à la page vingt.","Kitabın yirminci sayfasını açın.","Open the book at page twenty."],["Cette page est vide.","Bu sayfa boş.","This page is empty."]]},
  {"id":"qu'","level":"A1","pos":"other","ipa":"k","tr":"que'nin sesli harf önündeki biçimi (ki, ne)","en":"que before a vowel (that, what)","chunks":[["qu'est-ce que","ne","what"],["parce qu'il","çünkü o","because he"]],"examples":[["Qu'est-ce que tu fais ?","Ne yapıyorsun?","What are you doing?"],["Je pense qu'elle est là.","Sanırım o burada.","I think that she is here."]]},
  {"id":"radio","level":"A1","pos":"noun","gender":"f","plural":"radios","ipa":"ʁa.djo","tr":"radyo","en":"radio","chunks":[["écouter la radio","radyo dinlemek","to listen to the radio"],["à la radio","radyoda","on the radio"]],"examples":[["J'écoute la radio le matin.","Sabahları radyo dinlerim.","I listen to the radio in the morning."],["Il y a une bonne chanson à la radio.","Radyoda güzel bir şarkı var.","There is a good song on the radio."]]},
  {"id":"s'appelle","lemma":"il s'appelle","level":"A1","pos":"expression","ipa":"il sa.pɛl","tr":"onun adı ...","en":"his name is, it is called","chunks":[["elle s'appelle","onun (kadın) adı ...","her name is"],["comment ça s'appelle ?","bunun adı ne?","what is this called?"]],"examples":[["Mon frère s'appelle Ali.","Erkek kardeşimin adı Ali.","My brother's name is Ali."],["Comment s'appelle ton chat ?","Kedinin adı ne?","What is your cat's name?"]]},
  {"id":"t-shirt","level":"A1","pos":"noun","gender":"m","plural":"t-shirts","ipa":"ti.ʃœʁt","tr":"tişört","en":"T-shirt","chunks":[["porter un t-shirt","tişört giymek","to wear a T-shirt"],["un t-shirt blanc","beyaz bir tişört","a white T-shirt"]],"examples":[["J'achète un t-shirt noir.","Siyah bir tişört alıyorum.","I'm buying a black T-shirt."],["Ce t-shirt est trop petit.","Bu tişört çok küçük.","This T-shirt is too small."]]},
  {"id":"un","level":"A1","pos":"other","ipa":"œ̃","tr":"bir (eril)","en":"a, an, one (masculine)","chunks":[["un café","bir kahve","a coffee"],["un peu","biraz","a little"]],"examples":[["J'ai un frère.","Bir erkek kardeşim var.","I have one brother."],["Un café, s'il vous plaît.","Bir kahve, lütfen.","A coffee, please."]]},
  {"id":"vacances","level":"A1","pos":"noun","gender":"f","plural":"vacances","pluralOnly":true,"ipa":"va.kɑ̃s","tr":"tatil","en":"holiday, vacation","chunks":[["en vacances","tatilde","on holiday"],["bonnes vacances !","iyi tatiller!","have a good holiday!"]],"examples":[["Je suis en vacances.","Tatildeyim.","I am on holiday."],["Les vacances commencent demain.","Tatil yarın başlıyor.","The holidays start tomorrow."]]},
  {"id":"web","level":"A2","pos":"noun","gender":"m","plural":"web","ipa":"wɛb","tr":"web, internet","en":"the web","chunks":[["un site web","web sitesi","a website"],["sur le web","internette","on the web"]],"examples":[["Je cherche un site web.","Bir web sitesi arıyorum.","I'm looking for a website."],["On trouve tout sur le web.","İnternette her şey bulunur.","You can find everything on the web."]]},
  {"id":"y en","lemma":"il y en a","level":"A2","pos":"expression","ipa":"i.ljɑ̃.na","tr":"(ondan) var","en":"there is some, there are some","chunks":[["il n'y en a pas","(ondan) yok","there isn't any"],["il y en a deux","(ondan) iki tane var","there are two of them"]],"examples":[["Du pain ? Oui, il y en a.","Ekmek mi? Evet, var.","Bread? Yes, there is some."],["Il n'y en a plus.","Artık kalmadı.","There is none left."]]},
  {"id":"zéro","level":"A1","pos":"noun","gender":"m","plural":"zéros","ipa":"ze.ʁo","tr":"sıfır","en":"zero","chunks":[["zéro degré","sıfır derece","zero degrees"],["partir de zéro","sıfırdan başlamak","to start from scratch"]],"examples":[["Il fait zéro degré ce matin.","Bu sabah hava sıfır derece.","It is zero degrees this morning."],["Mon numéro commence par zéro.","Numaram sıfırla başlıyor.","My number starts with zero."]]},
  {"id":"à droite","level":"A1","pos":"expression","ipa":"a dʁwat","tr":"sağda, sağa","en":"on the right, to the right","chunks":[["tourner à droite","sağa dönmek","to turn right"],["à droite de","-in sağında","to the right of"]],"examples":[["Tournez à droite après la banque.","Bankadan sonra sağa dönün.","Turn right after the bank."],["La pharmacie est à droite.","Eczane sağda.","The pharmacy is on the right."]]},
  {"id":"bague","level":"A2","pos":"noun","gender":"f","plural":"bagues","ipa":"baɡ","tr":"yüzük","en":"ring","chunks":[["une bague en or","altın yüzük","a gold ring"],["porter une bague","yüzük takmak","to wear a ring"]],"examples":[["Elle porte une belle bague.","Güzel bir yüzük takıyor.","She is wearing a beautiful ring."],["J'ai perdu ma bague.","Yüzüğümü kaybettim.","I lost my ring."]]},
  {"id":"c'était","level":"A2","pos":"expression","ipa":"se.tɛ","tr":"idi, -ydı","en":"it was","chunks":[["c'était bien","güzeldi","it was good"],["c'était qui ?","kimdi?","who was it?"]],"examples":[["C'était un bon film.","İyi bir filmdi.","It was a good film."],["Hier, c'était mon anniversaire.","Dün doğum günümdü.","Yesterday was my birthday."]]},
  {"id":"d'accord","level":"A1","pos":"expression","ipa":"da.kɔʁ","tr":"tamam, anlaştık","en":"okay, agreed","chunks":[["être d'accord","aynı fikirde olmak","to agree"],["je ne suis pas d'accord","katılmıyorum","I don't agree"]],"examples":[["D'accord, on y va !","Tamam, gidelim!","Okay, let's go!"],["Tu es d'accord avec moi ?","Benimle aynı fikirde misin?","Do you agree with me?"]]},
  {"id":"facilement","level":"A2","pos":"other","ipa":"fa.sil.mɑ̃","tr":"kolayca","en":"easily","chunks":[["très facilement","çok kolayca","very easily"],["apprendre facilement","kolayca öğrenmek","to learn easily"]],"examples":[["Elle apprend facilement.","O kolayca öğreniyor.","She learns easily."],["On trouve facilement un taxi ici.","Burada kolayca taksi bulunur.","You can easily find a taxi here."]]},
  {"id":"gant","level":"A2","pos":"noun","gender":"m","plural":"gants","ipa":"ɡɑ̃","tr":"eldiven","en":"glove","chunks":[["une paire de gants","bir çift eldiven","a pair of gloves"],["mettre ses gants","eldivenlerini takmak","to put on one's gloves"]],"examples":[["Il fait froid, mets tes gants.","Hava soğuk, eldivenlerini tak.","It's cold, put on your gloves."],["J'ai perdu un gant.","Bir eldivenimi kaybettim.","I lost a glove."]]},
  {"id":"habitude","level":"A2","pos":"noun","gender":"f","plural":"habitudes","ipa":"a.bi.tyd","tr":"alışkanlık","en":"habit","chunks":[["d'habitude","genellikle","usually"],["avoir l'habitude de","-e alışkın olmak","to be used to"]],"examples":[["C'est une bonne habitude.","Bu iyi bir alışkanlık.","It's a good habit."],["D'habitude, je me lève à sept heures.","Genellikle saat yedide kalkarım.","Usually, I get up at seven."]]},
  {"id":"idée","level":"A1","pos":"noun","gender":"f","plural":"idées","ipa":"i.de","tr":"fikir","en":"idea","chunks":[["une bonne idée","iyi bir fikir","a good idea"],["aucune idée","hiçbir fikrim yok","no idea"]],"examples":[["C'est une bonne idée !","Bu iyi bir fikir!","That's a good idea!"],["J'ai une idée.","Bir fikrim var.","I have an idea."]]},
  {"id":"j'ai","level":"A1","pos":"expression","ipa":"ʒe","tr":"benim ... var","en":"I have","chunks":[["j'ai faim","açım","I'm hungry"],["j'ai froid","üşüyorum","I'm cold"],["j'ai vingt ans","yirmi yaşındayım","I am twenty"]],"examples":[["J'ai deux sœurs.","İki kız kardeşim var.","I have two sisters."],["J'ai une question.","Bir sorum var.","I have a question."]]},
  {"id":"kilomètre","level":"A1","pos":"noun","gender":"m","plural":"kilomètres","ipa":"ki.lɔ.mɛtʁ","tr":"kilometre","en":"kilometre","chunks":[["à dix kilomètres","on kilometre uzakta","ten kilometres away"],["kilomètres à l'heure","saatte kilometre","kilometres per hour"]],"examples":[["La plage est à deux kilomètres.","Plaj iki kilometre uzakta.","The beach is two kilometres away."],["Je cours cinq kilomètres.","Beş kilometre koşuyorum.","I run five kilometres."]]},
  {"id":"l'air","lemma":"air","level":"A2","pos":"noun","gender":"m","plural":"airs","ipa":"ɛʁ","tr":"hava; görünüş","en":"air; look","chunks":[["en plein air","açık havada","in the open air"],["avoir l'air","... gibi görünmek","to look, to seem"]],"examples":[["L'air est frais ce matin.","Bu sabah hava serin.","The air is fresh this morning."],["Tu as l'air fatigué.","Yorgun görünüyorsun.","You look tired."]]},
  {"id":"ma","level":"A1","pos":"other","ipa":"ma","tr":"benim (dişil isimlerle)","en":"my (with feminine nouns)","chunks":[["ma mère","annem","my mother"],["ma maison","evim","my house"]],"examples":[["Ma sœur habite à Lyon.","Kız kardeşim Lyon'da oturuyor.","My sister lives in Lyon."],["Voici ma chambre.","İşte odam.","Here is my room."]]},
  {"id":"n'aime pas","lemma":"je n'aime pas","level":"A1","pos":"expression","ipa":"ʒə nɛm pa","tr":"sevmiyorum","en":"I don't like","chunks":[["je n'aime pas ça","bunu sevmiyorum","I don't like that"],["je n'aime pas du tout","hiç sevmiyorum","I don't like it at all"]],"examples":[["Je n'aime pas le café.","Kahveyi sevmem.","I don't like coffee."],["Je n'aime pas me lever tôt.","Erken kalkmayı sevmiyorum.","I don't like getting up early."]]},
  {"id":"octobre","level":"A1","pos":"other","ipa":"ɔk.tɔbʁ","tr":"ekim (ay)","en":"October","chunks":[["en octobre","ekimde","in October"],["le premier octobre","bir ekim","the first of October"]],"examples":[["Mon anniversaire est en octobre.","Doğum günüm ekimde.","My birthday is in October."],["Il pleut souvent en octobre.","Ekimde sık sık yağmur yağar.","It often rains in October."]]},
  {"id":"pain","level":"A1","pos":"noun","gender":"m","plural":"pains","ipa":"pɛ̃","tr":"ekmek","en":"bread","chunks":[["du pain","(biraz) ekmek","some bread"],["une tranche de pain","bir dilim ekmek","a slice of bread"]],"examples":[["Je vais acheter du pain.","Ekmek alacağım.","I'm going to buy bread."],["Ce pain est très bon.","Bu ekmek çok lezzetli.","This bread is very good."]]},
  {"id":"qu'est-ce qu'","level":"A1","pos":"expression","ipa":"kɛs k","tr":"ne (sesli harf önünde)","en":"what (before a vowel)","chunks":[["qu'est-ce qu'il y a ?","ne var, ne oldu?","what's the matter?"],["qu'est-ce qu'on fait ?","ne yapıyoruz?","what are we doing?"]],"examples":[["Qu'est-ce qu'il fait ?","O ne yapıyor?","What is he doing?"],["Qu'est-ce qu'elle veut ?","O ne istiyor?","What does she want?"]]},
  {"id":"raisin","level":"A1","pos":"noun","gender":"m","plural":"raisins","ipa":"ʁɛ.zɛ̃","tr":"üzüm","en":"grapes","chunks":[["du raisin","(biraz) üzüm","some grapes"],["un jus de raisin","üzüm suyu","a grape juice"]],"examples":[["J'aime le raisin noir.","Siyah üzümü severim.","I like black grapes."],["Ce raisin est très sucré.","Bu üzüm çok tatlı.","These grapes are very sweet."]]},
  {"id":"s'il te plaît","level":"A1","pos":"expression","ipa":"sil tə plɛ","tr":"lütfen (senli)","en":"please (informal)","chunks":[["oui, s'il te plaît","evet, lütfen","yes, please"],["s'il vous plaît","lütfen (sizli)","please (formal)"]],"examples":[["Passe-moi le sel, s'il te plaît.","Tuzu uzatır mısın, lütfen.","Pass me the salt, please."],["Attends-moi, s'il te plaît.","Beni bekle, lütfen.","Wait for me, please."]]},
  {"id":"un de ces jours","level":"A2","pos":"expression","ipa":"œ̃ də se ʒuʁ","tr":"bir gün, yakında","en":"one of these days","chunks":[["à un de ces jours !","yakında görüşürüz!","see you one of these days!"],["passe un de ces jours","bir gün uğra","drop by one of these days"]],"examples":[["On se voit un de ces jours ?","Bir gün görüşelim mi?","Shall we meet one of these days?"],["Un de ces jours, j'irai à Paris.","Bir gün Paris'e gideceğim.","One of these days, I'll go to Paris."]]},
  {"id":"vache","level":"A1","pos":"noun","gender":"f","plural":"vaches","ipa":"vaʃ","tr":"inek","en":"cow","chunks":[["le lait de vache","inek sütü","cow's milk"],["une vache laitière","süt ineği","a dairy cow"]],"examples":[["Il y a des vaches dans le champ.","Tarlada inekler var.","There are cows in the field."],["La vache mange de l'herbe.","İnek ot yiyor.","The cow is eating grass."]]},
  {"id":"week-end","level":"A1","pos":"noun","gender":"m","plural":"week-ends","ipa":"wi.kɛnd","tr":"hafta sonu","en":"weekend","chunks":[["bon week-end !","iyi hafta sonları!","have a good weekend!"],["ce week-end","bu hafta sonu","this weekend"]],"examples":[["Qu'est-ce que tu fais ce week-end ?","Bu hafta sonu ne yapıyorsun?","What are you doing this weekend?"],["Le week-end, je dors tard.","Hafta sonları geç saate kadar uyurum.","At the weekend, I sleep late."]]},
  {"id":"y sommes","lemma":"nous y sommes","level":"A2","pos":"expression","ipa":"nu.zi sɔm","tr":"oradayız; vardık","en":"we are there; here we are","chunks":[["nous y sommes presque","neredeyse vardık","we are almost there"],["on y est","vardık","we're there"]],"examples":[["Ça y est, nous y sommes !","İşte, vardık!","That's it, here we are!"],["Nous y sommes depuis lundi.","Pazartesiden beri oradayız.","We have been there since Monday."]]},
  {"id":"zoo","level":"A1","pos":"noun","gender":"m","plural":"zoos","ipa":"zo","tr":"hayvanat bahçesi","en":"zoo","chunks":[["aller au zoo","hayvanat bahçesine gitmek","to go to the zoo"],["les animaux du zoo","hayvanat bahçesi hayvanları","the zoo animals"]],"examples":[["Les enfants adorent le zoo.","Çocuklar hayvanat bahçesine bayılır.","Children love the zoo."],["Nous allons au zoo dimanche.","Pazar günü hayvanat bahçesine gidiyoruz.","We are going to the zoo on Sunday."]]},
  {"id":"à l'étage","level":"A2","pos":"expression","ipa":"a le.taʒ","tr":"üst katta","en":"upstairs","chunks":[["monter à l'étage","üst kata çıkmak","to go upstairs"],["au premier étage","birinci katta","on the first floor"]],"examples":[["Les chambres sont à l'étage.","Yatak odaları üst katta.","The bedrooms are upstairs."],["Il travaille à l'étage.","Üst katta çalışıyor.","He works upstairs."]]},
  {"id":"baguette","level":"A1","pos":"noun","gender":"f","plural":"baguettes","ipa":"ba.ɡɛt","tr":"baget (ekmek)","en":"baguette","chunks":[["une baguette, s'il vous plaît","bir baget, lütfen","a baguette, please"],["une demi-baguette","yarım baget","half a baguette"]],"examples":[["J'achète une baguette tous les matins.","Her sabah bir baget alırım.","I buy a baguette every morning."],["La baguette est encore chaude.","Baget hâlâ sıcak.","The baguette is still warm."]]},
